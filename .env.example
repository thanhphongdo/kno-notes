# ── Database ────────────────────────────────────────────────────────────────
# Local dev (Homebrew Postgres). Production on Vercel: use the Neon URL, the
# client auto-switches to the neon-http driver for *.neon.tech hosts.
DATABASE_URL=postgresql://spt@localhost:5432/kno_notes_dev

# ── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me-in-production-0000000000

# ── Note + quiz storage ─────────────────────────────────────────────────────
# When all three GITHUB_* vars are set, notes/images are stored in the private
# GitHub repo. Otherwise the filesystem adapter under DATA_DIR is used (dev/test).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
DATA_DIR=.data

# ── Quiz generation (optional) ──────────────────────────────────────────────
# Without a key, quiz questions fall back to the offline generator.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Kno-Notes
# Set to 1 in CI/e2e so the embedding model is never downloaded.
NEXT_PUBLIC_DISABLE_SEMANTIC_SEARCH=
